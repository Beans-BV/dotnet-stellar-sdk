<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Unit tests for the validation app's code that runs without a network or a device. Like the app, it is not
        part of stellar-dotnet-sdk.sln. CI runs it (.github/workflows/pack_and_test.yml).
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>12</LangVersion>
        <IsPackable>false</IsPackable>
        <RootNamespace>StellarDotnetSdk.MauiValidation.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\StreamSearch.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
        <PackageReference Include="MSTest.TestAdapter" Version="2.2.10" />
        <PackageReference Include="MSTest.TestFramework" Version="2.2.10" />
    </ItemGroup>
</Project>

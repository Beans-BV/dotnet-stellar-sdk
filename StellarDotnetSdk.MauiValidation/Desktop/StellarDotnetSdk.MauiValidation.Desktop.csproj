<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Runs the MAUI app's validation checks (../ValidationRunner.cs) as a desktop console app: the baseline the
        mobile results are compared with in docs/maui-compatibility.md. Like the MAUI app, it is not part of
        stellar-dotnet-sdk.sln, because it talks to Stellar Testnet. CI builds it but does not run it
        (.github/workflows/pack_and_test.yml), so that the checks keep compiling against the SDK.
        Run it from the repository root with dotnet run and the project path StellarDotnetSdk.MauiValidation/Desktop.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>12</LangVersion>
        <IsPackable>false</IsPackable>
        <RootNamespace>StellarDotnetSdk.MauiValidation</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\ValidationRunner.cs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\StellarDotnetSdk\StellarDotnetSdk.csproj" />
    </ItemGroup>
</Project>
